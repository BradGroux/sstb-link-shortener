# Local Development Environment Variables
# Copy this file to .dev.vars and fill in your actual values
# .dev.vars is gitignored and will be used by wrangler dev


# One-time first-owner setup token. Generate independently for each environment.
# Example command: openssl rand -hex 32
SETUP_TOKEN=

# Required for privacy-preserving, daily-rotating visitor identifiers.
# Requests that would record analytics fail closed when this is absent.
ANALYTICS_IP_HASH_SECRET=

# Cloudflare API credentials (required for querying Analytics Engine)
# Get your account ID from: https://dash.cloudflare.com/ (in the URL or right sidebar)
CLOUDFLARE_ACCOUNT_ID=
# Use a narrow token with Account Analytics Read only.
CLOUDFLARE_API_TOKEN=
